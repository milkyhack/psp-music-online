#!/bin/sh
# Strip Cursor / cursoragent attribution trailers from commit messages.
MSG_FILE="$1"
[ -f "$MSG_FILE" ] || exit 0
tmp=$(mktemp)
grep -viE '^(Co-authored-by:[[:space:]]*(Cursor|cursoragent).*|Made-with:[[:space:]]*Cursor|Made with Cursor)' "$MSG_FILE" > "$tmp" || true
awk 'NF{p=1} p{print}' "$tmp" | awk 'BEGIN{blank=0} /^$/{blank++; if(blank<=1) print; next} {blank=0; print}' > "$MSG_FILE"
rm -f "$tmp"
exit 0
